# Any OpenAI-compatible endpoint: vLLM, Ollama, LiteLLM, OpenAI, a lab gateway.
BASTET_LLM_BASE_URL=http://localhost:8000/v1
BASTET_LLM_API_KEY=sk-noauth
BASTET_LLM_MODEL=your-model-id
# Leave blank to verify with the same model that detected.
BASTET_LLM_VERIFIER_MODEL=

BASTET_LLM_TEMPERATURE=0.0
BASTET_LLM_MAX_TOKENS=3000
BASTET_LLM_SEED=20260725
BASTET_LLM_TIMEOUT=180
BASTET_LLM_MAX_RETRIES=4
BASTET_CONCURRENCY=8

# Response cache. Delete the file to force fresh generations.
BASTET_CACHE=.bastet_cache.sqlite3
BASTET_CACHE_ENABLED=1

# Optional, only feeds the cost column in reports ($ per 1M tokens).
BASTET_PRICE_IN=0
BASTET_PRICE_OUT=0
