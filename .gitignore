# Corpus. 6.8 GB of Code4rena repositories and their archives -- fetched, not authored.
# Provenance and checksums live in data/splits.json; see README for the download URLs.
data/*.zip
data/ex/
data/dataset.csv

# Upstream Bastet is cloned, not vendored. Our additions to it are mirrored into
# bastet-cc/scripts/ so they are versioned without carrying someone else's tree.
upstream-bastet/

# Secrets. The AIS3 gateway token is issued per team and belongs in the environment.
.env
*.cookies
**/kaggle.json

.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw per-call transcripts: they embed contract source and prompts verbatim, and grow
# with every run. The derived measurements beside them are what the writeup cites.
# Leading **/ matters -- a bare `runs/` anchors to the repository root and silently
# misses bastet-cc/runs/, which is where these actually live.
**/runs/**/llm_log.jsonl
**/runs/**/llm_calls.jsonl
**/runs/**/results.jsonl
**/runs/**/tasks.jsonl
